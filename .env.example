# Copy to .env.local (gitignored) and fill in. Server-side only: never prefix with NEXT_PUBLIC_.
TYPESAFE_API_KEY=
# Optional: pin a model (defaults to jev-latest)
# TYPESAFE_DEFAULT_MODEL=jev-latest
# Optional local extractor (see README, "Extracting values with a local model"). Defaults shown.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=lfm25-350m-sft
# Optional speech-to-text (voice mode, in progress). Any server with POST /v1/audio/transcriptions works
# (faster-whisper-server, whisper.cpp server, vLLM for Qwen3-ASR). Defaults shown.
# STT_PROVIDER=openai-compatible
# STT_URL=http://127.0.0.1:8000
# STT_MODEL=Systran/faster-whisper-small.en
# Live (streaming) voice: a WebSocket server speaking src/lib/stt/stream/protocol.ts, e.g. voice/server (the browser connects to it directly).
# Without it the mic button records, then transcribes with the STT_* settings above.
# STT_STREAM_URL=ws://127.0.0.1:8765
# Proactive finance agent (in progress): AGENT_ENABLED=true serves the /agent page. Off by default, so the demo at / is unchanged.
# AGENT_ENABLED=true
